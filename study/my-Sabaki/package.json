{
  "name": "sabaki",
  "productName": "my-Sabaki",
  "version": "0.60.2",
  "description": "Personal study fork of Sabaki. Unstable; use https://github.com/SabakiHQ/Sabaki instead.",
  "author": "Yichuan Shen <shen.yichuan@gmail.com>",
  "homepage": "http://sabaki.yichuanshen.de",
  "license": "MIT",
  "main": "./src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/lots/my-Sabaki"
  },
  "bugs": {
    "url": "https://github.com/SabakiHQ/Sabaki/issues"
  },
  "build": {
    "appId": "io.github.lots.mysabaki",
    "copyright": "Copyright © 2015-2026 Yichuan Shen; study fork by lots. Not the original Sabaki.",
    "compression": "normal",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "toolsets": {
      "appimage": "1.0.2"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "my-sabaki-v${version}-linux-${arch}.${ext}"
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "baseVersion": "23.08",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Flatpak"
      ],
      "artifactName": "my-sabaki-v${version}-linux-${arch}-beta.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "notarize": true,
      "category": "public.app-category.board-games",
      "artifactName": "my-sabaki-v${version}-mac-${arch}.${ext}"
    },
    "win": {
      "artifactName": "my-sabaki-v${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "sgf",
        "name": "SGF",
        "description": "Smart Game Format"
      },
      {
        "ext": "ngf",
        "name": "NGF",
        "description": "wBaduk NGF"
      },
      {
        "ext": "gib",
        "name": "GIB",
        "description": "Tygem GIB"
      },
      {
        "ext": "ugf",
        "name": "UGF",
        "description": "PandaNET UGF"
      }
    ],
    "files": [
      "**/*",
      "!**/{.github,.c9,scss,docs,test,tests,devtools,plugins,examples}${/*}",
      "!ci${/*}",
      "!src/{components,modules}${/*}",
      "!engines",
      "!node_modules",
      "node_modules/@primer/octicons/build/svg/*",
      "node_modules/@sabaki/deadstones/wasm/*",
      "node_modules/@sabaki/shudan/css/*",
      "node_modules/@sabaki/i18n/**/*",
      "node_modules/dolm/**/*",
      "node_modules/{iconv-lite,safer-buffer}/**/*",
      "node_modules/pikaday/css/*"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "proseWrap": "always",
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "dependencies": {
    "@mariotacke/color-thief": "^3.0.1",
    "@primer/octicons": "^19.29.2",
    "@sabaki/boardmatcher": "^1.2.0",
    "@sabaki/deadstones": "^2.2.0",
    "@sabaki/go-board": "^1.4.1",
    "@sabaki/gtp": "^3.1.1",
    "@sabaki/i18n": "0.51.1-1",
    "@sabaki/immutable-gametree": "^1.9.4",
    "@sabaki/influence": "^1.2.2",
    "@sabaki/sgf": "^3.5.0",
    "@sabaki/shudan": "^1.8.0",
    "argv-split": "^3.2.1",
    "classnames": "^2.2.6",
    "dolm": "^0.7.3-beta",
    "fix-path": "<6.0.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.0.0",
    "natsort": "^2.0.2",
    "pikaday": "^1.8.0",
    "preact": "^10.29.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "uuid": "^14.0.1",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "mocha": "^11.7.6",
    "onchange": "^7.1.0",
    "prettier": "3.9.5",
    "rimraf": "^6.1.3",
    "tmp": "^0.2.7",
    "tsx": "^4.23.12",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "scripts": {
    "test": "mocha --require tsx",
    "start": "electron ./",
    "bundle": "webpack --mode production",
    "build": "npm run bundle && electron-builder --dir",
    "format-base": "prettier \"**/*.{js,html,md}\" \"!{{dist,i18n}/**,bundle.js*}\"",
    "format-check": "npm run format-base -- --check",
    "format": "npm run format-base -- --write",
    "watch-format": "onchange \"**/*.{js,html,md}\" \"!{{dist,i18n}/**,bundle.js*}\" -- prettier --write {{changed}}",
    "watch": "concurrently \"webpack --mode development --watch\" \"npm run watch-format\"",
    "dist:macos": "npm run bundle && electron-builder -m --x64 --arm64 --publish never",
    "dist:linux": "npm run bundle && electron-builder -l --x64 --arm64 --publish never && node ./ci/normalizeArtifactNames.js",
    "dist:flatpak": "npm run bundle && electron-builder -l flatpak --publish never",
    "dist:win64": "npm run bundle && electron-builder -w --x64 --publish never && node ./ci/mv.js ./dist/sabaki-vx.x.x-win.exe ./dist/sabaki-vx.x.x-win-x64-setup.exe",
    "dist:win64-portable": "npm run bundle && electron-builder -w portable --x64 --publish never && node ./ci/mv.js ./dist/sabaki-vx.x.x-win.exe ./dist/sabaki-vx.x.x-win-x64-portable.exe",
    "dist:win": "npm run dist:win64 && npm run dist:win64-portable",
    "i18n": "node ./ci/createI18n.js",
    "gen:engine-transcripts": "node ./scripts/engine-transcripts/capture.mjs",
    "demo:markup": "tsx scripts/markup-demo/extract.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/markup-demo/render.ps1",
    "test:e2e": "webpack --mode development && (command -v xvfb-run >/dev/null 2>&1 && xvfb-run npx playwright test || npx playwright test)",
    "test:e2e:smoke": "webpack --mode development && (command -v xvfb-run >/dev/null 2>&1 && xvfb-run npx playwright test --project=smoke || npx playwright test --project=smoke)",
    "test:e2e:headed": "webpack --mode development && npx playwright test"
  }
}
