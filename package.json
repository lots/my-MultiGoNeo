{
  "name": "multigo-neo",
  "productName": "MultiGo Neo",
  "version": "1.1.0",
  "description": "A tree-based Go SGF editor and player modelled on the MultiGo workspace.",
  "main": "electron/main.js",
  "author": "ILLEGEAR",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/test-tree.js && node scripts/test-path.js",
    "test:path": "node scripts/test-path.js",
    "test:legacy": "node scripts/test-engine.js",
    "bundle": "node scripts/build-sabaki-bundle.mjs",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "pack": "electron-builder --dir --config electron-builder.config.js",
    "dist": "electron-builder --config electron-builder.config.js",
    "dist:win": "electron-builder --win --config electron-builder.config.js",
    "dist:mac": "electron-builder --mac --config electron-builder.config.js",
    "dist:linux": "electron-builder --linux --config electron-builder.config.js"
  },
  "devDependencies": {
    "@sabaki/go-board": "^1.4.3",
    "@sabaki/immutable-gametree": "^1.9.4",
    "@sabaki/sgf": "^3.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.illegear.multigoneo",
    "productName": "MultiGo Neo",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiGo Neo",
      "uninstallDisplayName": "MultiGo Neo ${version}",
      "artifactName": "MultiGo-Neo-${version}-setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MultiGo-Neo-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {}
}
